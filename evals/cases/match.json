    "expect": {
      "jdSkills": {
        "required": ["node.js", "postgresql"],
        "forbidden": []
      },
      "present": {
        "required": [],
        "forbidden": ["node.js", "typescript", "postgresql", "kubernetes", "terraform", "kafka", "docker"]
      },
      "matchScoreRange": [0, 20]
    }
  },
