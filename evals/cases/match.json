[
  {
    "id": "match-aligned-strong",
    "feature": "match",
    "rationale": "The happy path. A mid-level Node résumé against a well-aligned Node JD — the model should extract the JD's real stack and mark most of it present. If this case degrades, something broke badly.",
    "adversarial": false,
    "input": {
      "resume": "fixture:resumes/node-backend-mid.txt",
      "jd": "fixture:jds/node-backend-aligned.txt"
    },
    "expect": {
      "jdSkills": {
        "required": ["node.js", "postgresql", "redis", "docker"],
        "forbidden": ["kubernetes", "terraform", "kafka"]
      },
      "present": {
        "required": ["node.js", "postgresql", "redis", "docker"],
        "forbidden": []
      },
      "matchScoreRange": [70, 100]
    }
  },
  {
    "id": "match-stretch-senior",
    "feature": "match",
    "rationale": "A realistic stretch application: the same mid-level résumé against a senior JD demanding Kubernetes, Terraform and Kafka, none of which the résumé contains. The gaps are the whole point of the product, so they must be reported as gaps.",
    "adversarial": false,
    "input": {
      "resume": "fixture:resumes/node-backend-mid.txt",
      "jd": "fixture:jds/node-backend-senior.txt"
    },
    "expect": {
      "jdSkills": {
        "required": ["node.js", "typescript", "postgresql", "kubernetes", "terraform"],
        "forbidden": []
      },
      "present": {
        "required": ["node.js", "typescript", "postgresql"],
        "forbidden": ["kubernetes", "terraform", "kafka", "grpc"]
      },
      "matchScoreRange": [25, 75]
    }
  },
  {
